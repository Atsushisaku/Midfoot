{
  "name": "midfoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "姿勢可視化アプリ（スクワット／デッドリフト）- 姿勢が体格の関数であることを示す",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.deadlift.config.ts && vite build --config vite.deadlift-errors.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "vitest run --reporter=dot src/report.test.ts",
    "icon": "vitest run --reporter=dot src/icon.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.5"
  }
}
